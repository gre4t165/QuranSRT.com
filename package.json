{
  "name": "quran-srt-studio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Quran SRT Studio — buat subtitle Al-Qur'an (SRT/VTT/ASS) yang sinkron dengan murotal, langsung di browser.",
  "scripts": {
    "dev": "react-router dev --port 5173",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "php -S localhost:8080 -t build/client scripts/router.php",
    "typecheck": "react-router typegen && tsc --noEmit",
    "data": "node scripts/build-quran-data.mjs",
    "images": "python3 scripts/make-images.py"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "isbot": "^5",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "quran-json": "^3.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
