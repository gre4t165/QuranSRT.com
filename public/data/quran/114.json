{"number":114,"verses":[{"n":1,"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tr":"Qul aAAoothu birabbi alnnasi","id":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia","en":"Say, \"I seek refuge in the Lord of mankind"},{"n":2,"ar":"مَلِكِ ٱلنَّاسِ","tr":"Maliki alnnasi","id":"Raja manusia","en":"The Sovereign of mankind"},{"n":3,"ar":"إِلَٰهِ ٱلنَّاسِ","tr":"Ilahi alnnasi","id":"sembahan manusia","en":"The God of mankind"},{"n":4,"ar":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","tr":"Min sharri alwaswasi alkhannasi","id":"dari kejahatan (bisikan) setan yang bersembunyi","en":"From the evil of the retreating whisperer"},{"n":5,"ar":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","tr":"Allathee yuwaswisu fee sudoori alnnasi","id":"yang membisikkan (kejahatan) ke dalam dada manusia","en":"Who whispers [evil] into the breasts of mankind"},{"n":6,"ar":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","tr":"Mina aljinnati wa alnnasm","id":"dari (golongan) jin dan manusia","en":"From among the jinn and mankind"}]}