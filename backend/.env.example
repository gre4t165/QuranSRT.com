# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIs...
# Service role key — diperlukan untuk upload aset storyboard ke Storage (server-side).
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Storyboard Creator: OpenAI (Pipeline 1 — GPT scene & gambar) ───────────────
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=https://api.openai.com/v1
# Global style tag yang diappend ke setiap prompt gambar.
STORYBOARD_STYLE_TAG=2D digital cartoon with thick marker-like line work and flat fills

# ── Storyboard Creator: ElevenLabs (Pipeline 2 — voiceover) ────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# ── Storyboard Creator: Storage & Video (Pipeline 3 — kompilasi MP4) ───────────
# Bucket Supabase Storage tempat menyimpan audio, gambar, dan video hasil.
STORYBOARD_BUCKET=storyboard-assets
# Lokasi binary FFmpeg/ffprobe bila tidak ada di PATH.
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
