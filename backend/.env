# ── Supabase Configuration ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://quransrt.com,https://www.quransrt.com,http://localhost:3000

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── API Settings ──────────────────────────────────────────────────────────────
# Maximum concurrent audio downloads (default: 5)
MAX_CONCURRENT_DOWNLOADS=5

# Audio download timeout in seconds (default: 30)
AUDIO_DOWNLOAD_TIMEOUT=30

# Maximum retries for failed downloads (default: 3)
MAX_DOWNLOAD_RETRIES=3

# ── Rate Limiting (optional) ──────────────────────────────────────────────────
# Requests per minute per IP (set to 0 to disable)
RATE_LIMIT_PER_MINUTE=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
